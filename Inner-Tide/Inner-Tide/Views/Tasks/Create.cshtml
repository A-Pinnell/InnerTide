@model Inner_Tide.Models.Task;

@{
    ViewData["Title"] = "Tasks Create Page";
    ViewData["PageStylesheets"] = new[] { "tasks-dev-menu.css" };
    ViewData["PageScripts"] = new[] { "tasks-dev-menu.js" };

    ViewBag.TimeFrames = new List<SelectListItem> {
        new SelectListItem { Value = "Daily", Text = "Daily" },
        new SelectListItem { Value = "Weekly", Text = "Weekly" },
        new SelectListItem { Value = "Monthly", Text = "Monthly" },
    };

    ViewBag.CategoryTags = new List<SelectListItem> {
        new SelectListItem { Value = "Sleep", Text = "Sleep" },
        new SelectListItem { Value = "Hydration", Text = "Hydration" },
        new SelectListItem { Value = "Fitness", Text = "Fitness" },
        new SelectListItem { Value = "Learning", Text = "Learning" },
        new SelectListItem { Value = "Organization", Text = "Organization" },
        new SelectListItem { Value = "Mood", Text = "Mood" },
        new SelectListItem { Value = "Nutrition", Text = "Nutrition" },
        new SelectListItem { Value = "Social", Text = "Social" },
        new SelectListItem { Value = "Productivity", Text = "Productivity" },
        new SelectListItem { Value = "Finance", Text = "Finance" },
        new SelectListItem { Value = "Exploration", Text = "Exploration" },
        new SelectListItem { Value = "Habit", Text = "Habit" },
        new SelectListItem { Value = "Hobby", Text = "Hobby" },
        new SelectListItem { Value = "Wellness", Text = "Wellness" },
        new SelectListItem { Value = "Creativity", Text = "Creativity" },
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#eb9fe4">
    <title> Task Creation Menu — Inner Tide</title>
</head>
<body class="task-menu-page">
    <main>
        <div id="backToIndexButtonContainer">
            <div id="backToIndexButton" class="menuBubble">
                <a asp-area="" asp-controller="Tasks" asp-action="Index" id="backArrowTasks"></a>
            </div>
            <p class="aquariumBtnText"> Back </p>
        </div>

        <h1> Create a Task </h1>

        <form asp-controller="Tasks" asp-action="Create" method="POST" id="taskForm">
            <div class="auth-field">
                <label class="aquariumBtnText" asp-for="Title"> Title </label>
                <input class="menuBubble" asp-for="Title" placeholder="Enter the Title">
                <span asp-validation-for="Title" class="auth-error"></span>
            </div>

            <div class="auth-field">
                <label class="aquariumBtnText" asp-for="TimeFrame"> Time Frame </label>
                <select class="menuBubble" asp-for="TimeFrame" class="form-control" asp-items="ViewBag.TimeFrames"></select>
                <span asp-validation-for="TimeFrame" class="auth-error"></span>
            </div>

            <div class="auth-field">
                <label class="aquariumBtnText"  asp-for="CoinReward"> CoinReward </label>
                <input class="menuBubble"  asp-for="CoinReward" placeholder="Enter the Coin Reward">
                <span asp-validation-for="CoinReward" class="auth-error"></span>
            </div>

            <div class="auth-field">
                <label class="aquariumBtnText"  asp-for="CategoryTag" class="control-label"></label>
                <select class="menuBubble"  asp-for="CategoryTag" class="form-control" asp-items="ViewBag.CategoryTags"></select>
                <span asp-for="CategoryTag" class="text-danger"></span>
            </div>

            <div>
                <button id="submitBtn" class="menuBubble" type="submit"> Create </button>
            </div>
        </form>

    </main>
</body>
</html>


