<div id="developerToolsHost" hidden>
    @Html.AntiForgeryToken()
</div>

<script>
    (async () => {
        try {
            const response = await fetch("/developer-tools.html");
            if (!response.ok) {
                throw new Error(`Could not load developer tools (${response.status}).`);
            }

            const documentFragment = new DOMParser().parseFromString(await response.text(), "text/html");
            const developerTools = documentFragment.querySelector("#developerTools");
            const styles = [...documentFragment.querySelectorAll("style")];
            const developerToolsScript = documentFragment.querySelector("script");
            if (!developerTools || !developerToolsScript) {
                throw new Error("The developer tools document is missing required content.");
            }

            styles.forEach(style => document.head.append(style));
            document.body.append(developerTools);

            const script = document.createElement("script");
            script.textContent = developerToolsScript.textContent;
            document.body.append(script);
        } catch (error) {
            console.error("Could not initialize developer tools.", error);
        }
    })();
</script>
