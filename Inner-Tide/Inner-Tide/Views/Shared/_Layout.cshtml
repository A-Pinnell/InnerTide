<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - Inner Tide</title>
        <script>
            document.documentElement.classList.add("page-assets-loading");
            if (sessionStorage.getItem("innerTide.quizExitTransition") === "true") {
                document.documentElement.classList.add("quiz-return-pending");
            }
            if (sessionStorage.getItem("innerTide.taskToQuizTransition") === "true") {
                document.documentElement.classList.add("task-quiz-transition-pending");
            }
            if (new URLSearchParams(window.location.search).get("from") === "aquarium") {
                document.documentElement.classList.add("aquarium-transition-return");
            }

            if (/(?:^|\/)journals(?:\/(?:index|create))?\/?$/i.test(window.location.pathname)) {
                const from = new URLSearchParams(window.location.search).get("from");
                const resumeBackground = from === "journal-index"
                    || from === "journal-create"
                    || from === "aquarium-journal";
                const storageKey = "innerTide.journalBackgroundStartTime";
                const now = Date.now();
                const storedStartTime = Number(sessionStorage.getItem(storageKey));
                const startTime = resumeBackground && Number.isFinite(storedStartTime) && storedStartTime > 0
                    ? storedStartTime
                    : now;
                const duration = 30000;
                const elapsed = ((now - startTime) % duration + duration) % duration;

                sessionStorage.setItem(storageKey, String(startTime));
                document.documentElement.style.setProperty("--journal-background-animation-delay", `-${elapsed / 1000}s`);
                document.documentElement.classList.add("journal-background-active");
            }
        </script>
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
        @foreach (var stylesheet in ViewData["PageStylesheets"] as string[] ?? Array.Empty<string>()) {
            <link rel="stylesheet" href="~/css/@stylesheet" asp-append-version="true">
        }
        <link rel="stylesheet" href="~/css/site-common.css" asp-append-version="true">
        <script src="~/js/color.js" asp-append-version="true" defer></script>
        <script src="~/js/site.js" asp-append-version="true" defer></script>
        @foreach (var pageScript in ViewData["PageScripts"] as string[] ?? Array.Empty<string>()) {
            <script src="~/js/@pageScript" asp-append-version="true" defer></script>
        }
    </head>
    <body>
        @RenderBody()

        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
