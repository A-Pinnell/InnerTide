<script>
    (async () => {
        try {
            const response = await fetch("/help-popup.html");
            if (!response.ok) {
                throw new Error(`Could not load help popup (${response.status}).`);
            }

            const popupDocument = new DOMParser().parseFromString(await response.text(), "text/html");
            const popup = popupDocument.querySelector("#helpPopup");
            const styles = [...popupDocument.querySelectorAll("style")];
            const popupScript = popupDocument.querySelector("script");
            if (!popup || !popupScript) {
                throw new Error("The help popup document is missing required content.");
            }

            styles.forEach(style => document.head.append(style));
            document.body.append(popup);

            const script = document.createElement("script");
            script.textContent = popupScript.textContent;
            document.body.append(script);
        } catch (error) {
            console.error("Could not initialize the help popup.", error);
        }
    })();
</script>
