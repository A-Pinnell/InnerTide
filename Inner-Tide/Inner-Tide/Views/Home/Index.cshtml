@using Inner_Tide.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "Task Menu";

    var accountId = ViewData["AccountId"] as string ?? "";
    var coinCount = 0;
    var userName = "Chris Concept";
    var email = "";
    var accountSettingsMessage = TempData["AccountSettingsMessage"] as string;
    var accountSettingsMessageType = TempData["AccountSettingsMessageType"] as string ?? "error";

    if (User.Identity?.IsAuthenticated == true) {
        var currentUser = await UserManager.GetUserAsync(User);

        coinCount = currentUser.CoinCount;
        userName = currentUser.UserName;
        email = currentUser.Email;
    } else {
        coinCount = 0;

    }
}

<body class="task-menu-page" data-account-id="@accountId" data-account-settings-message="@(accountSettingsMessage != null ? "true" : "false")">
    <main class="game-shell">
        <header class="player-card profile-collapsed">
            <div class="profile-details" id="profile-details">
                <div class="player-copy">
                    <strong> @userName </strong>
                    <!-- <small>30 More Pearls needed to level up!</small> -->
                </div>
                <!-- <div class="xp-track"><span></span></div> -->
            </div>
            <button class="avatar" type="button">
                <img src="img/placeholder.webp" alt="">
                <span class="player-level">DEMO ACCOUNT</span>
            </button>
            <div class="coin-counter" id="coinCounterTask">
                <img src="img/coin.png" alt="">
                <span class="coin-total">
                    <span id="coin-count"> @coinCount </span>
                    <small>COINS</small>
                </span>
            </div>
        </header>

        <nav class="quick-tools">
            <button class="round-button" type="button">
                <button class="round-button" id="settingsButton" type="button">
                    <img src="img/settings_icon.png" alt="">
                </button>
                <button class="round-button" type="button">
                    <a asp-controller="Users" asp-action="Logout"> <img src="img/logout_icon.png" alt=""> </a>
                </button>
                <button class="round-button" id="creditsButton" type="button">
                    <img src="img/credits_icon.png" alt="">
                </button>
        </nav>

        <aside class="side-tab aquarium-tab">
            <a asp-area="" asp-controller="Aquarium" asp-action="Index"> <span> Aquarium </span><b>›</b> </a>
        </aside>

        <h1 class="page-title" id="page-title"><span class="task-menu-version">P2 Demo</span> Task Menu</h1>

        <h1 class="page-title" id="page-title">Task Menu</h1>
        <section class="task-panel">
            <div class="tabs">
                <button class="tab" type="button" data-period="monthly"><span class="tab-label">Monthly</span></button>
                <button class="tab active" type="button" data-period="daily"><span class="tab-label">Daily</span></button>
                <button class="tab" type="button" data-period="weekly"><span class="tab-label">Weekly</span></button>
            </div>
            <div class="task-scroll" id="task-scroll">
                <div class="task-list" id="task-list"></div>
            </div>
        </section>

        <section class="options-panel" id="optionsPanel" inert hidden>
            <h2 id="optionsHeading">Options</h2>
            @if (accountSettingsMessage != null) {
                <p class="account-settings-message @accountSettingsMessageType" role="status">@accountSettingsMessage</p>
            }
            <details class="options-dropdown">
                <summary>Graphic Settings</summary>
                <div class="options-dropdown-content">
                    <fieldset class="graphical-presentation">
                        <legend>Graphical Presentation</legend>
                        <label class="graphical-option">
                            <input type="radio" name="graphicalPresentation" value="default">
                            <span>Default</span>
                        </label>
                        <label class="graphical-option">
                            <input type="radio" name="graphicalPresentation" value="advanced">
                            <span>Advanced</span>
                        </label>
                    </fieldset>
                    <fieldset class="graphical-presentation">
                        <legend>Reduce Motion</legend>
                        <label class="graphical-option">
                            <input type="radio" name="reduceMotion" value="on">
                            <span>On</span>
                        </label>
                        <label class="graphical-option">
                            <input type="radio" name="reduceMotion" value="off">
                            <span>Off</span>
                        </label>
                    </fieldset>
                </div>
            </details>
            <details class="options-dropdown">
                <summary>Sound Settings</summary>
                <div class="options-dropdown-content">
                    <fieldset class="audio-volume-setting">
                        <legend>Music Volume</legend>
                        <label class="audio-volume-control">
                            <input id="musicVolume" type="range" min="0" max="100" step="1" value="50">
                            <output id="musicVolumeValue" for="musicVolume">50%</output>
                        </label>
                    </fieldset>
                    <fieldset class="audio-volume-setting">
                        <legend>SFX Volume</legend>
                        <label class="audio-volume-control">
                            <input id="sfxVolume" type="range" min="0" max="100" step="1" value="50">
                            <output id="sfxVolumeValue" for="sfxVolume">50%</output>
                        </label>
                    </fieldset>
                </div>
            </details>
            <details class="account-settings">
                <summary>Account Settings</summary>
                <form asp-controller="Users" asp-action="UpdateAccountSettings" method="post">
                    <label>
                        <span>Username</span>
                        <input type="text" name="NewUserName" autocomplete="username" value="@userName">
                    </label>
                    <label>
                        <span>Email Address</span>
                        <input type="email" name="NewEmail" autocomplete="email" value="@email">
                    </label>
                    <label>
                        <span>Current Password (required to save)</span>
                        <input type="password" name="CurrentPassword" autocomplete="current-password" required>
                    </label>
                    <button class="options-back" type="submit">Save Account Changes</button>
                </form>
            </details>
            <button class="options-back" id="optionsBackButton" type="button">Back to Tasks</button>
        </section>

        <section class="options-panel credits-panel" id="creditsPanel" inert hidden>
            <img class="credits-logo" src="img/Team_1.png" alt="Serene Stallions">
            <ul class="credits-list">
                <li>Alyssa Pinnell</li>
                <li>Emma Sauve</li>
                <li>Matthew Johnston</li>
            </ul>
            <button class="options-back" id="creditsBackButton" type="button">Back to Tasks</button>
        </section>

        <button class="help-button" type="button" aria-label="Open menu help">
            <img src="img/help_icon.png" alt="">
        </button>

        <div class="elements-backdrop" id="elements-backdrop"></div>
        <section class="elements-panel" id="elements-panel">
            <div class="elements-actions">
                <button class="element-action" type="button" data-elements-action="regenerate">
                    <span class="element-action-icon element-icon"><img src="img/refresh_tasks.png" alt=""></span>
                    <span>Regenerate Tasks</span>
                </button>
                <a class="element-action" asp-area="" asp-controller="Quiz" asp-action="Index">
                    <span class="element-action-icon element-icon"><img src="img/additional_quiz.png" alt=""></span>
                    <span>Additional Quizzes</span>
                </a>
                <button class="element-action" type="button" data-elements-action="stats" hidden>
                    <span class="element-action-icon element-icon"><img src="img/task_stats.png" alt=""></span>
                    <span>Task Generation Stats</span>
                </button>
                <button class="element-action elements-list" type="button">
                    <span class="element-action-icon element-icon"><img src="img/aquarium_list.png" alt=""></span>
                    <span>Aquarium List</span>
                </button>
            </div>

            <div class="elements-status" data-percent="0">
                <div class="status-tank">
                    <div class="tank-water">
                        <span class="wave wave-back"></span>
                        <span class="wave wave-front"></span>
                    </div>
                    <span class="status-percent">0%</span>
                    <span class="tank-stand"></span>
                </div>
                <div class="status-copy">
                    <strong>Aquarium Status</strong>
                    <em id="aquariumStatusMessage">A great start!</em>
                </div>
            </div>

            <button class="elements-toggle side-tab elements-tab" type="button">
                <span>Elements</span><b>›</b>
            </button>
        </section>

        <svg focusable="false" width="0" height="0">
            <filter id="background-water-ripple" x="-15%" y="-15%" width="130%" height="130%">
                <feTurbulence type="fractalNoise" baseFrequency=".004 .01" numOctaves="2" seed="4" result="water-noise">
                    <animate attributeName="baseFrequency" values=".004 .01;.007 .014;.004 .01" dur="18s" repeatCount="indefinite" />
                </feTurbulence>
                <feDisplacementMap in="SourceGraphic" in2="water-noise" scale="42" xChannelSelector="R" yChannelSelector="G" />
            </filter>
        </svg>
        @await Html.PartialAsync("_DeveloperTools")
        @await Html.PartialAsync("_HelpPopup")
    </main>
    <section class="aquarium-selector" id="aquariumSelector" hidden inert>
        <div class="aquarium-selector-stage" id="aquariumSelectorStage"></div>
        <button class="aquarium-selector-arrow aquarium-selector-previous" id="aquariumSelectorPrevious" type="button"></button>
        <button class="aquarium-selector-arrow aquarium-selector-next" id="aquariumSelectorNext" type="button"></button>
        <h2 class="aquarium-selector-title" id="aquariumSelectorTitle">Aquarium 1</h2>
        <button class="aquarium-selector-choose" id="aquariumSelectorChoose" type="button">Choose</button>
        <button class="aquarium-selector-close" id="aquariumSelectorClose" type="button">×</button>
        <div class="aquarium-unlock-popup" id="aquariumUnlockPopup" role="alertdialog" aria-modal="true" aria-labelledby="aquariumUnlockMessage" hidden>
            <div class="aquarium-unlock-popup-card">
                <p id="aquariumUnlockMessage"></p>
                <button id="aquariumUnlockClose" type="button">Confirm</button>
            </div>
        </div>
    </section>
</body>