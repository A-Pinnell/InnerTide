@{
    ViewData["Title"] = "Journal Menu";
    ViewData["BodyClass"] = "journal-menu-page";
    ViewData["PageStylesheets"] = new[] { "journals-menu.css" };
    ViewData["PageScripts"] = new[] { "journal-menu.js" };
}

<script>
    document.body.classList.add("journal-menu-page");
    if (new URLSearchParams(window.location.search).get("from") === "journal-create") {
        document.body.classList.add("journal-return-from-create");
    }
</script>

        <section id="upperSandHeader">
            <h1 id="journalH1"> Journals </h1>
            <div id="sand"></div>
            <div id="sand-layer"></div>
            <div id="sand2"></div>

            <div id="backToAquariumButtonContainer">
                <div id="backToAquariumButton" class="journalMenuBubble">
                    <a asp-area="" asp-controller="Aquarium" asp-action="Index" id="backArrow"></a>
                </div>
                <p class="aquariumBtnText"> Aquarium </p>
            </div>

            <div id="createJournalButtonContainer">
                <div id="createJournalButton" class="journalMenuBubble" type="button" title="Create journal entry">
                    <a asp-area="" asp-controller="Journals" asp-action="Create">
                        <svg viewBox="0 0 48 48" focusable="false">
                            <path d="M8 32.5V40h7.5L37.6 17.9l-7.5-7.5L8 32.5Zm35.4-21.2a2 2 0 0 0 0-2.8l-3.9-3.9a2 2 0 0 0-2.8 0l-3.7 3.7 7.5 7.5 2.9-4.5Z" />
                        </svg>
                    </a>
                </div>
                <p id="createJournalButtonText">Create</p>
            </div>
        </section>

        <audio id="journal-music" loop preload="auto"></audio>

        <main id="journalMain">
            <section id="JournalHistoryContainer"> </section>

            <section id="journalTextContainer">
                <div id="journalTextBackground">
                    <h2 id="journalEntryTitle"></h2>
                    <div id="journalEntryText">
                        <p> Click a Journal to Read its Contents </p>
                    </div>

                    <div id="journalButtonContainer">
                        <div id="viewFullButtonContainer">
                            <div id="viewFullBtn" class="journalMenuBubble">
                                <a id=""></a>
                            </div>
                             <p class="aquariumBtnText"> View Full </p>
                        </div>

                        <div id="deleteButtonContainer">
                            <div id="deleteJournalBtn" class="journalMenuBubble">
                                <a id="XIcon"></a>
                            </div>
                            <p class="aquariumBtnText"> Delete </p>
                        </div>
                    </div>
                </div>
            </section>
            <dialog id="journalDeleteDialog" class="journal-delete-dialog">
                <h2 id="journalDeleteHeading">Are you sure?</h2>
                <p id="journalDeleteMessage">This will permanently erase this journal.</p>
                <div class="journal-delete-dialog-actions">
                    <button id="journalDeleteCancel" type="button">Cancel</button>
                    <button id="journalDeleteConfirm" type="button">Delete journal</button>
                </div>
            </dialog>
            <svg focusable="false" width="0" height="0">
                <filter id="background-water-ripple" x="-15%" y="-15%" width="130%" height="130%">
                    <feTurbulence type="fractalNoise" baseFrequency=".004 .01" numOctaves="2" seed="4" result="water-noise">
                        <animate attributeName="baseFrequency" values=".004 .01;.007 .014;.004 .01" dur="18s" repeatCount="indefinite" />
                    </feTurbulence>
                    <feDisplacementMap in="SourceGraphic" in2="water-noise" scale="42" xChannelSelector="R" yChannelSelector="G" />
                </filter>
                <clipPath id="sand-base-shape" clipPathUnits="objectBoundingBox">
                    <path d="M0 .18 C.05 .18 .06 .13 .12 .13 C.18 .13 .17 .22 .23 .22 C.29 .22 .31 .15 .37 .15 C.44 .15 .44 .23 .5 .23 C.56 .23 .57 .14 .63 .14 C.69 .14 .69 .21 .75 .21 C.81 .21 .82 .15 .88 .15 C.94 .15 .95 .18 1 .18 L1 1 L0 1 Z" />
                </clipPath>
                <clipPath id="sand-middle-shape" clipPathUnits="objectBoundingBox">
                    <path d="M0 .18 C.06 .18 .07 .13 .13 .13 C.19 .13 .19 .23 .25 .23 C.31 .23 .32 .12 .38 .12 C.44 .12 .44 .21 .5 .21 C.56 .21 .58 .15 .64 .15 C.7 .15 .7 .24 .76 .24 C.82 .24 .83 .13 .89 .13 C.95 .13 .95 .18 1 .18 L1 1 L0 1 Z" />
                </clipPath>
                <clipPath id="sand-front-shape" clipPathUnits="objectBoundingBox">
                    <path d="M0 .18 C.05 .18 .07 .13 .13 .13 C.19 .13 .18 .23 .24 .23 C.3 .23 .32 .15 .38 .15 C.44 .15 .44 .24 .5 .24 C.56 .24 .57 .12 .63 .12 C.69 .12 .7 .22 .76 .22 C.82 .22 .83 .14 .89 .14 C.95 .14 .95 .18 1 .18 L1 1 L0 1 Z" />
                </clipPath>
            </svg>

        </main>
