@using Inner_Tide.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<User> UserManager
@model List<QuizQuestion>?

@{
    var setupQuiz = ViewData["SetupQuiz"] is true;
    var quizQuestions = Model ?? new List<QuizQuestion>();
    ViewData["Title"] = setupQuiz ? "Getting Started" : "Quiz";
}

<body class="question-page @(setupQuiz ? "setup-quiz-page" : "")">
    <main class="question-screen" data-setup-quiz="@setupQuiz.ToString().ToLowerInvariant()" data-save-answer-url="@Url.Action("SaveAnswer", "Quiz")">
        <div class="question-background"></div>
        <section class="question-copy">
            <p class="question-number">
                Question <span id="questionNumber">1</span>
                @if (!setupQuiz) {
                    <span> / @quizQuestions.Count</span>
                }
            </p>
            <h1 id="questionPrompt">@(quizQuestions.FirstOrDefault()?.Question?.QuestionTitle ?? "No questions are available.")</h1>
        </section>
        <ol id="setupQuizQuestions" hidden>
            @foreach (var quizQuestion in quizQuestions) {
                <li data-quiz-question-id="@quizQuestion.QuizQuestionId">@quizQuestion.Question?.QuestionTitle</li>
            }
        </ol>
        <form asp-controller="Quiz" asp-action="SaveAnswer" method="post" id="quizAnswerForm" hidden>
        </form>

        @if (setupQuiz) {
            <form asp-controller="Users" asp-action="FinishSetupQuiz" method="post" class="question-action-form" id="setupQuizForm">
                <input type="hidden" name="completed" id="setupQuizCompleted" value="false">
            </form>
        }

        <section class="answer-panel">
            <div class="answer-track" id="answerTrack">
                <button class="answer-choice" type="button" data-answer="0">
                    <span class="answer-circle"></span>
                    <span class="answer-label">Never</span>
                </button>
                <button class="answer-choice" type="button" data-answer="1">
                    <span class="answer-circle"></span>
                    <span class="answer-label">Rarely</span>
                </button>
                <button class="answer-choice" type="button" data-answer="2">
                    <span class="answer-circle"></span>
                    <span class="answer-label">Sometimes</span>
                </button>
                <button class="answer-choice" type="button" data-answer="3">
                    <span class="answer-circle"></span>
                    <span class="answer-label">Often</span>
                </button>
                <button class="answer-choice" type="button" data-answer="4">
                    <span class="answer-circle"></span>
                    <span class="answer-label">Always</span>
                </button>
                <img class="answer-fish" id="answerFish" src="../img/quiz-fish.png" alt="" hidden>
            </div>
            <button class="question-arrow question-next" id="nextQuestion" type="button">
                <span></span>
            </button>
        </section>
        @if (setupQuiz) {
            <div class="setup-quiz-progress" id="setupQuizProgress">
                <span class="setup-quiz-progress-fill" id="setupQuizProgressFill"></span>
                <img class="setup-quiz-progress-fish" id="setupQuizProgressFish" src="../img/quiz-fish.png" alt="">
            </div>
        }
        <p class="question-save-error" id="questionSaveError" role="alert" hidden>Could not save your answer. Please try again.</p>

        <nav class="question-actions">
            @if (!setupQuiz) {
                <a class="question-action" asp-area="" asp-controller="Quiz" asp-action="Index">Quit</a>
            }
        </nav>
        <button class="help-button" type="button">
            <img src="../img/help_icon.png" alt="">
        </button>
        <svg focusable="false" width="0" height="0">
            <filter id="background-water-ripple" x="-15%" y="-15%" width="130%" height="130%">
                <feTurbulence type="fractalNoise" baseFrequency=".004 .01" numOctaves="2" seed="4" result="water-noise">
                    <animate attributeName="baseFrequency" values=".004 .01;.007 .014;.004 .01" dur="18s" repeatCount="indefinite" />
                </feTurbulence>
                <feDisplacementMap in="SourceGraphic" in2="water-noise" scale="42" xChannelSelector="R" yChannelSelector="G" />
            </filter>
        </svg>
    </main>
    @await Html.PartialAsync("_HelpPopup")
</body>
</html>
