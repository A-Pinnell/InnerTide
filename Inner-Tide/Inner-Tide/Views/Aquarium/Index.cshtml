@{
    ViewData["Title"] = "Aquarium Menu";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0086B6">
    <title> Aquarium — Inner Tide </title>
    <link rel="stylesheet" href="../css/site.css">
    <script src="../js/site.js" defer></script>
</head>

<body class="aquarium-page aquarium-enter">
    <main>
        <div id="aquarium">
            <aside class="side-tab task-tab">
                <a asp-area="" asp-controller="Home" asp-action="Index"> <span> Task Menu </span> <b> ‹ </b> </a>
            </aside>

            <button class="help-button" type="button" data-message="Choose a task, complete it, and collect your reward!" aria-label="Help">
                <img src="../img/help_icon.png" alt="">
            </button>

            <div class="aquarium-scene" aria-hidden="true">
                <div class="aquarium-bubbles">
                    <span class="aquarium-bubble bubble-one"></span>
                    <span class="aquarium-bubble bubble-two"></span>
                    <span class="aquarium-bubble bubble-three"></span>
                    <span class="aquarium-bubble bubble-four"></span>
                    <span class="aquarium-bubble bubble-five"></span>
                    <span class="aquarium-bubble bubble-six"></span>
                    <span class="aquarium-bubble bubble-seven"></span>
                    <span class="aquarium-bubble bubble-eight"></span>
                </div>
            </div>
            <div id="sand"></div>
            <div id="sand-layer"></div>
            <div id="sand2"></div>

            <div id="storeCoinDiv">
                <div class="coin-counter" id="coinCounterAquarium">
                    <img src="../img/coin.png" alt="">
                    <span class="coin-total"><span id="coin-count">0</span><small>COINS</small></span>
                </div>

                <button class="aquariumMenuBtn" id="storeBtn" type="button" aria-controls="tankStorePanel">
                    <span class="aquarium-icon-frame">
                        <img src="../img/aquarium_store.png" alt="">
                    </span>
                    <span class="aquarium-menu-label">Tank Store</span>
                </button>
            </div>

            <div class="menu-buttons">
                <button class="aquariumMenuBtn" id="editorBtn" type="button" aria-controls="editorToolbar" aria-expanded="false">
                    <span class="aquarium-icon-frame">
                        <img src="../img/aquarium_editor.png" alt="">
                    </span>
                    <span class="aquarium-menu-label">Editor</span>
                </button>
                <button class="aquariumMenuBtn" id="inventoryBtn" type="button" aria-controls="tankInventoryPanel">
                    <span class="aquarium-icon-frame">
                        <img src="../img/aquarium_inventory.png" alt="">
                    </span>
                    <span class="aquarium-menu-label">Inventory</span>
                </button>
            </div>

            <aside class="editor-toolbar" id="editorToolbar" aria-label="Aquarium layers" aria-hidden="true" inert hidden>
                <button class="editor-layer-heading" id="editorSwitchLayer" type="button" aria-label="Switch to foreground 2">
                    <span class="editor-layer-stack" aria-hidden="true"><i></i><b id="editorLayerNumber">1</b></span>
                    <span>Switch Layer</span>
                </button>
                <div class="editor-layer-list" aria-label="Items">
                    <div class="editor-item-slot" aria-hidden="true"></div>
                    <div class="editor-item-slot" aria-hidden="true"></div>
                    <div class="editor-item-slot" aria-hidden="true"></div>
                    <div class="editor-item-slot" aria-hidden="true"></div>
                    <div class="editor-item-slot" aria-hidden="true"></div>
                    <div class="editor-item-slot" aria-hidden="true"></div>
                    <div class="editor-item-slot" aria-hidden="true"></div>
                    <div class="editor-item-slot" aria-hidden="true"></div>
                    <button class="editor-layer-more" id="editorMoreItems" type="button" aria-label="Open inventory" aria-controls="editorInventoryPanel" aria-expanded="false">•••</button>
                </div>
                <button class="editor-close-button" id="editorCloseButton" type="button" aria-label="Close editor"><img src="../img/close_icon.png" alt=""></button>
            </aside>
            <div class="editor-foreground-label" id="editorForegroundLabel" aria-live="polite"><span>FOREGROUND</span><b id="editorForegroundNumber">1</b></div>

            <div class="editor-inventory-backdrop" id="editorInventoryBackdrop" hidden></div>
            <section class="editor-inventory-panel" id="editorInventoryPanel" role="dialog" aria-label="Inventory" hidden>
                <div class="store-tabs editor-inventory-tabs" aria-label="Inventory category">
                    <span class="store-tab active" data-position="center" role="heading" aria-level="2">Objects</span>
                </div>
                <div class="editor-inventory-items">
                    <div class="store-items">
                        <div class="store-item" aria-label="Aquarium object"><span class="store-product object-product"></span></div>
                        <div class="store-item" aria-label="Aquarium object"><span class="store-product object-product"></span></div>
                        <div class="store-item" aria-label="Aquarium object"><span class="store-product object-product"></span></div>
                        <div class="store-item" aria-label="Aquarium object"><span class="store-product object-product"></span></div>
                        <div class="store-item" aria-label="Aquarium object"><span class="store-product object-product"></span></div>
                        <div class="store-item" aria-label="Aquarium object"><span class="store-product object-product"></span></div>
                        <div class="store-item" aria-label="Aquarium object"><span class="store-product object-product"></span></div>
                        <div class="store-item" aria-label="Aquarium object"><span class="store-product object-product"></span></div>
                        <div class="store-item" aria-label="Aquarium object"><span class="store-product object-product"></span></div>
                        <div class="store-item" aria-label="Aquarium object"><span class="store-product object-product"></span></div>
                        <div class="store-item" aria-label="Aquarium object"><span class="store-product object-product"></span></div>
                        <div class="store-item" aria-label="Aquarium object"><span class="store-product object-product"></span></div>
                    </div>
                </div>
            </section>

            <div class="tank-store-backdrop" id="tankStoreBackdrop" hidden></div>
            <section class="tank-store-panel" id="tankStorePanel" role="dialog" aria-label="Tank Store" hidden>
                <div class="store-tabs" role="tablist" aria-label="Store categories">
                    <button class="store-tab" id="storeObjectsTab" type="button" role="tab" aria-selected="false" aria-controls="storeObjects" data-category="objects">Objects</button>
                    <button class="store-tab active" id="storeFishTab" type="button" role="tab" aria-selected="true" aria-controls="storeFish" data-category="fish">Fish</button>
                </div>
                <div class="store-catalog" id="storeFish" role="tabpanel" aria-labelledby="storeFishTab">
                    <div class="store-items">
                        <div class="store-item" aria-label="Fish, 25 coins"><span class="store-product fish-product"></span><span class="store-price"><img src="../img/coin.png" alt="">25</span></div>
                    </div>
                </div>
                <div class="store-catalog" id="storeObjects" role="tabpanel" aria-labelledby="storeObjectsTab" hidden>
                    <div class="store-items">
                        <div class="store-item" aria-label="Aquarium object, 25 coins"><span class="store-product object-product"></span><span class="store-price"><img src="../img/coin.png" alt="">25</span></div>
                    </div>
                </div>
            </section>

            <div class="tank-store-backdrop" id="tankInventoryBackdrop" hidden></div>
            <section class="tank-store-panel" id="tankInventoryPanel" role="dialog" aria-label="Inventory" hidden>
                <div class="store-tabs" role="tablist" aria-label="Inventory categories">
                    <button class="store-tab" id="inventoryObjectsTab" type="button" role="tab" aria-selected="false" aria-controls="inventoryObjects" data-category="objects">Objects</button>
                    <button class="store-tab active" id="inventoryFishTab" type="button" role="tab" aria-selected="true" aria-controls="inventoryFish" data-category="fish">Fish</button>
                </div>
                <div class="store-catalog" id="inventoryFish" role="tabpanel" aria-labelledby="inventoryFishTab">
                    <div class="store-items">
                        <div class="store-item" aria-label="Fish"><span class="store-product fish-product"></span></div>
                    </div>
                </div>
                <div class="store-catalog" id="inventoryObjects" role="tabpanel" aria-labelledby="inventoryObjectsTab" hidden>
                    <div class="store-items">
                        <div class="store-item" aria-label="Aquarium object"><span class="store-product object-product"></span></div>
                    </div>
                </div>
            </section>

            <div id="journalButton">
                <a class="journalText" asp-area="" asp-controller="Journals" asp-action="Index"> <span> Journals </span> <b> ˅ </b> </a>
            </div>
        </div>
        <svg aria-hidden="true" focusable="false" width="0" height="0">
            <filter id="background-water-ripple" x="-15%" y="-15%" width="130%" height="130%">
                <feTurbulence type="fractalNoise" baseFrequency=".004 .01" numOctaves="2" seed="4" result="water-noise">
                    <animate attributeName="baseFrequency" values=".004 .01;.007 .014;.004 .01" dur="18s" repeatCount="indefinite" />
                </feTurbulence>
                <feDisplacementMap in="SourceGraphic" in2="water-noise" scale="42" xChannelSelector="R" yChannelSelector="G" />
            </filter>
            <clipPath id="sand-base-shape" clipPathUnits="objectBoundingBox">
                <path d="M0 .18 C.05 .18 .06 .13 .12 .13 C.18 .13 .17 .22 .23 .22 C.29 .22 .31 .15 .37 .15 C.44 .15 .44 .23 .5 .23 C.56 .23 .57 .14 .63 .14 C.69 .14 .69 .21 .75 .21 C.81 .21 .82 .15 .88 .15 C.94 .15 .95 .18 1 .18 L1 1 L0 1 Z" />
            </clipPath>
            <clipPath id="sand-middle-shape" clipPathUnits="objectBoundingBox">
                <path d="M0 .18 C.06 .18 .07 .13 .13 .13 C.19 .13 .19 .23 .25 .23 C.31 .23 .32 .12 .38 .12 C.44 .12 .44 .21 .5 .21 C.56 .21 .58 .15 .64 .15 C.7 .15 .7 .24 .76 .24 C.82 .24 .83 .13 .89 .13 C.95 .13 .95 .18 1 .18 L1 1 L0 1 Z" />
            </clipPath>
            <clipPath id="sand-front-shape" clipPathUnits="objectBoundingBox">
                <path d="M0 .18 C.05 .18 .07 .13 .13 .13 C.19 .13 .18 .23 .24 .23 C.3 .23 .32 .15 .38 .15 C.44 .15 .44 .24 .5 .24 C.56 .24 .57 .12 .63 .12 C.69 .12 .7 .22 .76 .22 C.82 .22 .83 .14 .89 .14 C.95 .14 .95 .18 1 .18 L1 1 L0 1 Z" />
            </clipPath>
        </svg>
    </main>
</body>
</html>