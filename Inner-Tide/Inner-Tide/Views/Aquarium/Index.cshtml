@using Inner_Tide.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "Aquarium Menu";
    ViewData["PageStylesheets"] = new[] { "task-menu.css", "aquarium-menu.css" };
    ViewData["PageScripts"] = new[] { "aquarium-menu.js" };

    var accountId = ViewData["AccountId"] as string ?? "";
    var coinCount = 0;
    var aquariumNumber = (int)ViewData["AquariumNumber"]!;
    var aquariumId = (int)ViewData["AquariumId"]!;
    var aquariumBackgroundNumber = (int)ViewData["AquariumBackgroundNumber"]!;

    if (User.Identity?.IsAuthenticated == true) {
        var currentUser = await UserManager.GetUserAsync(User);

        coinCount = currentUser.CoinCount;
    } else {
        coinCount = 0;
    }
}

<body id="aquariumBody" class="aquarium-page aquarium-enter" data-account-id="@accountId" data-aquarium-number="@aquariumNumber" data-aquarium-id="@aquariumId" data-aquarium-background-number="@aquariumBackgroundNumber">
    <audio id="aquarium-music" autoplay preload="auto"></audio>
    <main>
        <div id="aquarium">
            <form id="pelletActionToken" hidden>
                @Html.AntiForgeryToken()
            </form>
            <div class="fish-loading-indicator" id="fishLoadingIndicator">
                <img src="../img/loading.gif" alt="">
            </div>
            <div class="fish-startle-message" id="fishStartleMessage" hidden>
                Please don't tap the glass too much! Let the fish swim in peace.
            </div>
            <div id="fishContainer"> 

            </div>
            <button class="aquarium-fish-info-backdrop" id="aquariumFishInfoBackdrop" type="button" hidden></button>
            <aside class="aquarium-fish-info" id="aquariumFishInfo" hidden>
                <button class="aquarium-fish-info-close" id="aquariumFishInfoClose" type="button">
                    <img src="../img/close_icon.png" alt="">
                </button>
                <p class="aquarium-fish-info-eyebrow" id="aquariumFishInfoAcquiredAt"></p>
                <h2 id="aquariumFishInfoTitle"></h2>
                <p class="aquarium-fish-info-description" id="aquariumFishInfoDescription"></p>
                <section class="aquarium-fish-info-facts" id="aquariumFishInfoFactsSection" hidden>
                    <h3>Fish Fact !</h3>
                    <ul id="aquariumFishInfoFacts"></ul>
                </section>
            </aside>

            <aside class="side-tab task-tab">
                <a asp-area="" asp-controller="Home" asp-action="Index"> <span> Task Menu </span> <b> ‹ </b> </a>
            </aside>

            <button class="help-button" type="button">
                <img src="../img/help_icon.png" alt="">
            </button>
            <div class="feeding-controls" id="feedingControls" hidden>
                <div class="feeding-pellet-picker" id="feedingPelletPicker" hidden>
                    <button class="feeding-pellet-choice" type="button" data-pellet-type="small">
                        <span class="feeding-pellet-preview small"></span>
                        <span>Small pellet</span>
                        <span data-pellet-count="small">0</span>
                    </button>
                    <button class="feeding-pellet-choice" type="button" data-pellet-type="large">
                        <span class="feeding-pellet-preview large"></span>
                        <span>Large pellet</span>
                        <span data-pellet-count="large">0</span>
                    </button>
                </div>
                <button class="feeding-bag-button" id="feedingBagButton" type="button" aria-expanded="false" aria-controls="feedingPelletPicker" aria-label="Choose a fish pellet">
                    <img src="../img/bag.png" alt="">
                </button>
                <span class="feeding-status" id="feedingStatus" role="status" aria-live="polite"></span>
            </div>
            <div class="held-pellet-preview" id="heldPelletPreview" hidden></div>

            <div class="aquarium-scene">
                <div class="aquarium-bubbles">
                    <span class="aquarium-bubble bubble-one"></span>
                    <span class="aquarium-bubble bubble-two"></span>
                    <span class="aquarium-bubble bubble-three"></span>
                    <span class="aquarium-bubble bubble-four"></span>
                    <span class="aquarium-bubble bubble-five"></span>
                    <span class="aquarium-bubble bubble-six"></span>
                    <span class="aquarium-bubble bubble-seven"></span>
                    <span class="aquarium-bubble bubble-eight"></span>
                </div>
            </div>
            <div id="sand"></div>
            <div id="sand-layer"></div>
            <div id="sand2"></div>
            <div class="sand-object-grid" id="waterObjectGridBack" data-sand-layer="3" data-grid-region="water"></div>
            <div class="sand-object-grid" id="waterObjectGridCenter" data-sand-layer="4" data-grid-region="water"></div>
            <div class="sand-object-grid" id="waterObjectGridTop" data-sand-layer="5" data-grid-region="water"></div>
            <div class="sand-object-grid" id="sandObjectGridBack" data-sand-layer="0"></div>
            <div class="sand-object-grid" id="sandObjectGridCenter" data-sand-layer="1"></div>
            <div class="sand-object-grid" id="sandObjectGridTop" data-sand-layer="2"></div>
            <div class="sand-grid-overlay"></div>
            <div class="editor-placement-notice" id="editorPlacementNotice" hidden></div>
            <div class="hide-mode-clock" id="hideModeClock">
                <time id="hideModeTime"></time>
                <span id="hideModeDate"></span>
            </div>

            <div id="storeCoinDiv">
                <div class="coin-counter" id="coinCounterAquarium">
                    <img src="../img/coin.png" alt="">
                    <span class="coin-total">
                        <span id="coin-count"> @coinCount </span>
                        <small>COINS</small>
                    </span>
                </div>

                <button class="aquariumMenuBtn" id="storeBtn" type="button">
                    <span class="aquarium-icon-frame">
                        <img src="../img/aquarium_store.png" alt="">
                    </span>
                    <span class="aquarium-menu-label">Tank Store</span>
                </button>
            </div>

            <div class="menu-buttons">
                <button class="aquariumMenuBtn" id="editorBtn" type="button">
                    <span class="aquarium-icon-frame">
                        <img src="../img/aquarium_inventory.png" alt="">
                        <img class="editor-inventory-priority" id="editorInventoryPriorityBadge" src="../img/priority-task.png" alt="" hidden>
                    </span>
                    <span class="aquarium-menu-label">Editor</span>
                </button>
                <!-- <button class="aquariumMenuBtn" id="actionsBtn" type="button">
                    <span class="aquarium-icon-frame">
                        <img src="../img/aquarium_editor.png" alt="">
                    </span>
                    <span class="aquarium-menu-label">Actions</span>
                </button> -->
            </div>
            <button class="aquariumMenuBtn aquarium-hide-button" id="aquariumHideButton" type="button">
                <span class="aquarium-icon-frame">
                    <img src="../img/close_crab.png" alt="">
                </span>
                <span class="aquarium-menu-label">Hide</span>
            </button>

            <aside class="editor-toolbar" id="editorToolbar" inert hidden>
                <div class="editor-layer-list">
                    <button class="editor-item-slot" type="button" disabled></button>
                    <button class="editor-item-slot" type="button" disabled></button>
                    <button class="editor-item-slot" type="button" disabled></button>
                    <button class="editor-item-slot" type="button" disabled></button>
                    <button class="editor-item-slot" type="button" disabled></button>
                    <button class="editor-item-slot" type="button" disabled></button>
                    <button class="editor-item-slot" type="button" disabled></button>
                    <button class="editor-item-slot" type="button" disabled></button>
                    <button class="editor-layer-more" id="editorMoreItems" type="button"><img src="../img/inventory_editor.png" alt=""></button>
                </div>
                <button class="editor-close-button" id="editorCloseButton" type="button"><img src="../img/close_icon.png" alt=""></button>
                <span class="editor-return-prompt">Put Back in Inventory</span>
            </aside>
            <nav class="editor-layer-menu" id="editorLayerMenu" inert hidden>
                <button class="editor-layer-option is-selected" type="button" data-layer-index="0" title="Back water">
                    <img src="../img/editor_waterLayer.png" alt="">
                </button>
                <button class="editor-layer-option" type="button" data-layer-index="1" title="Center water">
                    <img src="../img/editor_waterLayer.png" alt="">
                </button>
                <button class="editor-layer-option" type="button" data-layer-index="2" title="Top water">
                    <img src="../img/editor_waterLayer.png" alt="">
                </button>
                <button class="editor-layer-option editor-fish-layer-option" type="button" data-layer-index="3" title="Fish layer">
                    <img src="../img/quiz-fish.png" alt="">
                </button>
                <button class="editor-layer-option" type="button" data-layer-index="4" title="Back sand layer">
                    <img src="../img/editor_sandLayer.png" alt="">
                </button>
                <button class="editor-layer-option" type="button" data-layer-index="5" title="Center sand layer">
                    <img src="../img/editor_sandLayer.png" alt="">
                </button>
                <button class="editor-layer-option" type="button" data-layer-index="6" title="Top sand layer">
                    <img src="../img/editor_sandLayer.png" alt="">
                </button>
            </nav>
            <div class="editor-foreground-label" id="editorForegroundLabel"><span id="editorForegroundName">Back Water</span><b id="editorForegroundNumber">1</b></div>

            <div class="editor-inventory-backdrop" id="editorInventoryBackdrop" hidden></div>
            <h2 class="editor-inventory-heading" id="editorInventoryHeading" hidden>Inventory</h2>
            <section class="tank-store-panel editor-inventory-panel" id="editorInventoryPanel" hidden>
                <div class="store-tabs editor-inventory-tabs">
                    <button class="store-tab active" type="button" data-category="fish" data-position="center">Fish</button>
                    <button class="store-tab" type="button" data-category="objects" data-position="right">Objects</button>
                </div>
                <div class="store-catalog" id="inventoryFish">
                    <div class="store-items"></div>
                </div>
                <div class="store-catalog" id="inventoryObjects" hidden>
                    <div class="store-items"></div>
                </div>
            </section>

            <div class="tank-store-backdrop" id="tankStoreBackdrop" hidden></div>
            <section class="tank-store-panel" id="tankStorePanel" hidden>
                <div class="store-tabs">
                    <button class="store-tab" id="storeObjectsTab" type="button" data-category="objects">Objects</button>
                    <button class="store-tab active" id="storeFishTab" type="button" data-category="fish">Fish</button>
                    <button class="store-tab" id="storeMiscTab" type="button" data-category="misc">Misc</button>
                </div>
                <div class="store-catalog" id="storeFish">
                    <div class="store-items">
                        <div class="store-item"><span class="store-product fish-product"></span><span class="store-price"><img src="../img/coin.png" alt=""><span class="store-price-value">25</span></span></div>
                    </div>
                </div>
                <div class="store-catalog" id="storeObjects" hidden>
                    <div class="store-items">
                        <div class="store-item"><span class="store-product object-product"></span><span class="store-price"><img src="../img/coin.png" alt=""><span class="store-price-value">25</span></span></div>
                    </div>
                </div>
                <div class="store-catalog" id="storeMisc" hidden>
                    <div class="store-items">
                        <button class="store-item pellet-store-item" type="button" data-pellet-type="small">
                            <span class="store-item-image"><span class="store-pellet-preview small"></span></span>
                            <span class="store-item-details">
                                <span class="store-product-name">Small Pellet</span>
                                <span class="store-price"><img src="../img/coin.png" alt=""><span class="store-price-value">1</span></span>
                            </span>
                        </button>
                        <button class="store-item pellet-store-item" type="button" data-pellet-type="large">
                            <span class="store-item-image"><span class="store-pellet-preview large"></span></span>
                            <span class="store-item-details">
                                <span class="store-product-name">Large Pellet</span>
                                <span class="store-price"><img src="../img/coin.png" alt=""><span class="store-price-value">3</span></span>
                            </span>
                        </button>
                    </div>
                </div>
            </section>

            <div class="inventory-fish-limit-message" id="inventoryFishLimitMessage" hidden>
                Can not add more then 10 fish. Please remove a fish or start a new aquarium!
            </div>

            <!-- <div id="journalButton">
                <a class="journalText" asp-area="" asp-controller="Journals" asp-action="Index"> <span> Journals </span> <b> ˅ </b> </a>
            </div> -->
            <button class="aquariumMenuBtn aquarium-hide-exit" id="aquariumHideExit" type="button" aria-label="Show aquarium menu" hidden>
                <span class="aquarium-icon-frame">
                    <img src="../img/open_crab.png" alt="">
                </span>
                <span class="aquarium-menu-label">Show</span>
            </button>
        </div>
        <svg focusable="false" width="0" height="0">
            <filter id="background-water-ripple" x="-15%" y="-15%" width="130%" height="130%">
                <feTurbulence type="fractalNoise" baseFrequency=".004 .01" numOctaves="2" seed="4" result="water-noise">
                    <animate attributeName="baseFrequency" values=".004 .01;.007 .014;.004 .01" dur="18s" repeatCount="indefinite" />
                </feTurbulence>
                <feDisplacementMap in="SourceGraphic" in2="water-noise" scale="42" xChannelSelector="R" yChannelSelector="G" />
            </filter>
            <clipPath id="sand-base-shape" clipPathUnits="objectBoundingBox">
                <path d="M0 .18 C.05 .18 .06 .13 .12 .13 C.18 .13 .17 .22 .23 .22 C.29 .22 .31 .15 .37 .15 C.44 .15 .44 .23 .5 .23 C.56 .23 .57 .14 .63 .14 C.69 .14 .69 .21 .75 .21 C.81 .21 .82 .15 .88 .15 C.94 .15 .95 .18 1 .18 L1 1 L0 1 Z" />
            </clipPath>
            <clipPath id="sand-middle-shape" clipPathUnits="objectBoundingBox">
                <path d="M0 .18 C.06 .18 .07 .13 .13 .13 C.19 .13 .19 .23 .25 .23 C.31 .23 .32 .12 .38 .12 C.44 .12 .44 .21 .5 .21 C.56 .21 .58 .15 .64 .15 C.7 .15 .7 .24 .76 .24 C.82 .24 .83 .13 .89 .13 C.95 .13 .95 .18 1 .18 L1 1 L0 1 Z" />
            </clipPath>
            <clipPath id="sand-front-shape" clipPathUnits="objectBoundingBox">
                <path d="M0 .18 C.05 .18 .07 .13 .13 .13 C.19 .13 .18 .23 .24 .23 C.3 .23 .32 .15 .38 .15 C.44 .15 .44 .24 .5 .24 C.56 .24 .57 .12 .63 .12 C.69 .12 .7 .22 .76 .22 C.82 .22 .83 .14 .89 .14 C.95 .14 .95 .18 1 .18 L1 1 L0 1 Z" />
            </clipPath>
        </svg>
        @await Html.PartialAsync("_DeveloperTools")
        @await Html.PartialAsync("_HelpPopup")
    </main>
</body>
