@{
    ViewData["Title"] = "Aquarium Menu";
}

<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8" />
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#0086B6">
        <title> Aquarium — Inner Tide </title>
        <link rel="stylesheet" href="../css/site.css">
        <script src="../js/site.js" defer></script>
    </head>

    <body class="aquarium-page aquarium-enter">
        <main>
            <div id="aquarium">
                <aside class="side-tab task-tab">
                    <a asp-area="" asp-controller="Home" asp-action="Index"> <span> Task Menu </span> <b> ‹ </b> </a>
                </aside>

                <div id="storeCoinDiv">
                    <div class="coin-counter" id="coinCounterAquarium">
                        <img src="../img/coin.png" alt="">
                        <span id="coin-count"> 0 </span>
                    </div>

                    <div class="aquariumMenuBtn" id="storeBtn"> Tank Store </div>
                </div>

                <div class="menu-buttons">
                    <div class="aquariumMenuBtn" id="inventoryBtn">
                        <div> Inventory </div>
                    </div>

                    <div class="aquariumMenuBtn" id="editorBtn">
                        <div> Editor </div>
                    </div>
                </div>

                <div id="sand"></div>
                <div id="sand2"></div>

                <div id="journalButton">
                    <a class="journalText" asp-area="" asp-controller="Journals" asp-action="Index"> <span> Journals </span> <b> ˅ </b> </a>
                </div>
            </div>
        </main>
    </body>
</html>