@using Inner_Tide.ViewModels
@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    ViewData["PageStylesheets"] = new[] { "users-menu.css" };
    ViewData["PageScripts"] = new[] { "users-menu.js" };
}

<body class="users-page">
    <main class="users-shell">

        <section class="users-promo">
            <img src="~/img/login_promo.png" alt="Inner Tide">
        </section>

        <section class="auth-panel">
            <div class="auth-view">
                <h1> Change Password </h1>
                <form asp-action="ChangePassword" method="post">
                    <fieldset>
                        <div class="auth-field">
                            <label asp-for="Email"> Email Address </label>
                            <input asp-for="Email" type="email" autocomplete="email" placeholder="you@email.com" />
                            <span asp-validation-for="Email" class="auth-error"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="NewPassword"> New Password </label>
                            <input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="Enter a new password" />
                            <span asp-validation-for="NewPassword" class="auth-error"></span>
                        </div>

                        <div class="auth-field auth-field-compact">
                            <label asp-for="ConfirmNewPassword"> Confirm </label>
                            <input asp-for="ConfirmNewPassword" type="password" autocomplete="new-password" placeholder="Confirm password" />
                            <span asp-validation-for="ConfirmNewPassword" class="auth-error"></span>
                        </div>

                        <div class="auth-actions">
                            <button type="submit" class="auth-submit"> Change Password </button>
                            <a asp-controller="Users" asp-action="Index" class="auth-switch"> Back to Login </a>
                        </div>
                    </fieldset>
                </form>
            </div>
        </section>

        <footer class="users-footer">
            <span>Dive In.</span>
            <img src="~/img/innertide_logo.png" alt="InnerTide">
        </footer>

        <button class="users-help" type="button">
            <img src="~/img/help_icon.png" alt="">
        </button>
    </main>
</body>