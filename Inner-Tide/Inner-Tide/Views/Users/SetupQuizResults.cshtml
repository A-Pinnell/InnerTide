@model Inner_Tide.ViewModels.SetupQuizResultsViewModel

@{
    ViewData["Title"] = "Your Setup Results";
}

<main class="setup-results-page">
    <section class="setup-results-card">
        <a class="setup-results-close" asp-controller="Home" asp-action="Index" title="Return to tasks">
            <img src="~/img/close_icon.png" alt="">
        </a>
        <h1>Your Inner Tide</h1>
        <br>
        <div class="setup-results-category-scroll">
            <div class="setup-results-categories">
                @foreach (var category in Model.Categories) {
                    <div class="setup-results-category">
                        <div class="setup-results-category-heading">
                            <label for="category-progress-@category.Name">@category.Name</label>
                            <span class="setup-results-percent">@category.Percentage%</span>
                        </div>
                        <progress class="setup-results-progress" id="category-progress-@category.Name" value="@category.Percentage" max="100">@category.Percentage%</progress>
                    </div>
                }
            </div>
        </div>
    </section>
</main>
