@model Inner_Tide.ViewModels.AccountViewModel

@{
	ViewData["Title"] = "Login & Register Page";
}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#eb9fe4">
        <title> Login and Register Menu — Inner Tide</title>
        <link rel="stylesheet" href="~/css/site.css">
        @* <script src="./js/site.js" defer></script> *@
    </head>
    <body class="task-menu-page">
        <main>
            <div id="registerContainer">
                <form asp-controller="Users" asp-action="Register" method="post">
                    <fieldset>
                        <h3> Register </h3>
                        <div>
                            <label asp-for="Register.UserName" class="control-label"></label>
                            <input asp-for="Register.UserName" class="form-control" />
                            <span asp-validation-for="Register.UserName" class="text-danger"></span>
                        </div>

                        <div>
                            <label asp-for="Register.Email" class="control-label"></label>
                            <input asp-for="Register.Email" class="form-control" />
                            <span asp-validation-for="Register.Email" class="text-danger"></span>
                        </div>

                        <div>
                            <label asp-for="Register.Password" class="control-label"></label>
                            <input asp-for="Register.Password" class="form-control" />
                            <span asp-validation-for="Register.Password" class="text-danger"></span>
                        </div>

                        <div>
                            <label asp-for="Register.ConfirmPassword" class="control-label"></label>
                            <input asp-for="Register.ConfirmPassword" class="form-control" />
                            <span asp-validation-for="Register.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <input type="submit" value="Register" class="btn btn-primary" />
                        </div>

                        <div asp-validation-summary="All" class="text-danger"></div>
                    </fieldset>
                </form>
            </div>

            <div id="loginContainer">
            <form asp-controller="Users" asp-action="Login" method="post">
                    <fieldset>
                        <h3> Login </h3>
                        <div>
                            <label asp-for="Login.Email" class="control-label"></label>
                            <input asp-for="Login.Email" class="form-control" />
                            <span asp-validation-for="Login.Email" class="text-danger"></span>
                        </div>

                        <div>
                            <label asp-for="Login.Password" class="control-label"></label>
                            <input asp-for="Login.Password" class="form-control" />
                            <span asp-validation-for="Login.Password" class="text-danger"></span>
                        </div>

                        <div class="float-end">
                            <a asp-controller="Users" asp-action="VerifyEmail" class="text-decoration-none"> Forgot Password </a>
                        </div>

                        <div class="form-check mb-3">
                            <label class="form-check-label">
                                <input asp-for="Login.RememberMe" class="form-check-input"/>
                                @Html.DisplayNameFor(a=> a.Login.RememberMe)
                            </label>
                        </div>

                        <div class="form-group">
                            <input type="submit" value="Login" class="btn btn-primary" />
                        </div>

                        <div class="text-center">
                            <a asp-controller="Home" asp-action="Index" class="text-decoration-none mt-3"> Back </a>
                        </div>

                        <div asp-validation-summary="All" class="text-danger"></div>
                    </fieldset>
                </form>
            </div>
            

            <a asp-action=""> </a>
        </main>
    </body>
</html>
