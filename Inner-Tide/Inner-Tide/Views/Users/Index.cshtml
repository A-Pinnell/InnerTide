@model Inner_Tide.ViewModels.AccountViewModel

@{
    ViewData["Title"] = "Login & Register Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#071b36">
    <title>Welcome — Inner Tide</title>
    <link rel="stylesheet" href="../css/site.css">
    <script src="../js/site.js" defer></script>
</head>

<body class="users-page">
    <main class="users-shell">
        <section class="users-promo">
            <img src="../img/login_promo.png">
        </section>

        <section class="auth-panel">
            <div id="registerContainer" class="auth-view">
                <form asp-controller="Users" asp-action="Register" method="post">
                    <fieldset>
                        <div class="auth-field">
                            <label asp-for="Register.Email">Email Address</label>
                            <input asp-for="Register.Email" type="email" autocomplete="email" placeholder="you@email.com">
                            <span asp-validation-for="Register.Email" class="auth-error"></span>
                        </div>

                        <div class="auth-field auth-field-compact">
                            <label asp-for="Register.UserName">Username</label>
                            <input asp-for="Register.UserName" type="text" autocomplete="username" placeholder="Choose a username">
                            <span asp-validation-for="Register.UserName" class="auth-error"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="Register.Password">Password</label>
                            <input asp-for="Register.Password" type="password" autocomplete="new-password" placeholder="Password">
                            <span asp-validation-for="Register.Password" class="auth-error"></span>
                        </div>



                        <div class="auth-field auth-field-compact">
                            <label asp-for="Register.ConfirmPassword">Confirm</label>
                            <input asp-for="Register.ConfirmPassword" type="password" autocomplete="new-password" placeholder="Confirm password">
                            <span asp-validation-for="Register.ConfirmPassword" class="auth-error"></span>
                        </div>

                        <div asp-validation-summary="All" class="auth-error auth-summary"></div>
                        <div class="auth-actions">
                            <button class="auth-submit" type="submit">Register</button>
                            <a class="auth-switch" href="#login" data-auth-view="login">or Log In</a>
                        </div>
                    </fieldset>
                </form>
            </div>

            <div id="loginContainer" class="auth-view" hidden>
                <form asp-controller="Users" asp-action="Login" method="post">
                    <fieldset>
                        <div class="auth-field">
                            <label asp-for="Login.Email">Email Address</label>
                            <input asp-for="Login.Email" type="email" autocomplete="email" placeholder="you@email.com">
                            <span asp-validation-for="Login.Email" class="auth-error"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="Login.Password">Password</label>
                            <input asp-for="Login.Password" type="password" autocomplete="current-password" placeholder="Password">
                            <span asp-validation-for="Login.Password" class="auth-error"></span>
                        </div>

                        <div class="auth-options">
                            <label class="remember-option">
                                <input asp-for="Login.RememberMe" type="checkbox">
                                <span>Remember me</span>
                            </label>
                            <a asp-controller="Users" asp-action="VerifyEmail">Forgot Password?</a>
                        </div>

                        <div asp-validation-summary="All" class="auth-error auth-summary"></div>
                        <div class="auth-actions">
                            <button class="auth-submit" type="submit">Log In</button>
                            <a class="auth-switch" href="#register" data-auth-view="register">or Register</a>
                        </div>
                    </fieldset>
                </form>
            </div>
        </section>

        <footer class="users-footer">
            <span>Dive In.</span>
            <img src="../img/innertide_logo.png" alt="InnerTide">
        </footer>

        <button class="users-help" type="button">
            <img src="../img/help_icon.png" alt="">
        </button>
    </main>

    <div class="startup-video" id="startup-video">
        <video id="startup-video-player" autoplay muted playsinline preload="auto"></video>
    </div>
</body>
<audio id="login-music" src="../music/Login.mp3" loop preload="auto"></audio>
</html>